{
  "name": "dsh-privmask",
  "description": "DeepSeek Harness 本地脱敏插件：请求上云前遮罩密钥、PII 与中文实体，用户输入与工具结果落盘前同样遮罩，支持入站还原与多版本 DSH 兼容。",
  "version": "0.2.51",
  "author": "JunyuZhan",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunyuZhan/dsh-privmask.git"
  },
  "homepage": "https://github.com/JunyuZhan/dsh-privmask#readme",
  "bugs": {
    "url": "https://github.com/JunyuZhan/dsh-privmask/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "pii",
    "dsh",
    "plugin",
    "脱敏",
    "隐私保护",
    "deepseek-harness",
    "cordis",
    "privacy",
    "redaction",
    "desensitization",
    "llm"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "build:check": "node tools/build-client.mjs --check",
    "test": "node test/self-test.js && node test/accuracy-test.js && node test/reliability-test.js && node test/fuzz-test.js && node test/docx-test.js",
    "prepublishOnly": "npm run build:check && npm test",
    "mask:preview": "node tools/mask-preview.mjs",
    "dsh:compat": "node tools/dsh-compat-check.mjs",
    "market:index": "node tools/build-market-index.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
