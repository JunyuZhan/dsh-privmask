{
  "name": "dsh-privmask",
  "description": "DeepSeek Harness 本地脱敏插件：在 llm/stream 出口拦截发往云端大模型的请求，将密钥、PII、中文实体（姓名/身份证/公司/机关/地址等）替换为占位符后再发送，本地会话日志保留原文。",
  "version": "0.2.25",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunyuZhan/dsh-privmask.git"
  },
  "homepage": "https://github.com/JunyuZhan/dsh-privmask#readme",
  "bugs": {
    "url": "https://github.com/JunyuZhan/dsh-privmask/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "privacy",
    "redaction",
    "desensitization",
    "llm"
  ],
  "scripts": {
    "prepublishOnly": "node test/self-test.js && node test/accuracy-test.js && node test/reliability-test.js && node test/fuzz-test.js",
    "mask:preview": "node tools/mask-preview.mjs"
  }
}
